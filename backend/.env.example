# Core
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/arteno
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-essa-senha
ADMIN_SESSION_SECRET=troque-por-um-segredo-forte
ADMIN_SESSION_MAX_AGE_SECONDS=28800

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo (opcional)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Arteno
BREVO_REPLY_TO_EMAIL=

# Mercado Pago
# TEST-... = sandbox
# APP_USR-... = producao
MERCADO_PAGO_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADO_PAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MERCADO_PAGO_NOTIFICATION_URL=https://seu-dominio.com/api/integrations/mercado-pago/webhook
MERCADO_PAGO_WEBHOOK_SECRET=troque-pelo-segredo-do-webhook
MERCADO_PAGO_STATEMENT_DESCRIPTOR=ARTENO

# Shipping demo
SHIPPING_DEMO_MODE=true

# Melhor Envio (opcional)
MELHOR_ENVIO_USE_SANDBOX=true
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_REDIRECT_URI=http://localhost:3001/api/admin/integrations/melhor-envio/callback
MELHOR_ENVIO_USER_AGENT=Arteno (suporte@arteno.local)
MELHOR_ENVIO_FROM_POSTAL_CODE=
MELHOR_ENVIO_SCOPE=cart-read cart-write shipping-calculate shipping-generate shipping-checkout shipping-cancel shipping-tracking
MELHOR_ENVIO_WEBHOOK_SECRET=
MELHOR_ENVIO_WEBHOOK_URL=https://seu-dominio.com/api/integrations/melhor-envio/webhook

# Dados do remetente do Melhor Envio
MELHOR_ENVIO_NON_COMMERCIAL=true
MELHOR_ENVIO_SENDER_NAME=
MELHOR_ENVIO_SENDER_PHONE=
MELHOR_ENVIO_SENDER_EMAIL=
MELHOR_ENVIO_SENDER_DOCUMENT=
MELHOR_ENVIO_SENDER_COMPANY_DOCUMENT=
MELHOR_ENVIO_SENDER_STATE_REGISTER=ISENTO
MELHOR_ENVIO_SENDER_ADDRESS=
MELHOR_ENVIO_SENDER_NUMBER=
MELHOR_ENVIO_SENDER_COMPLEMENT=
MELHOR_ENVIO_SENDER_DISTRICT=
MELHOR_ENVIO_SENDER_CITY=
MELHOR_ENVIO_SENDER_STATE=
